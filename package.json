{
  "name": "src",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run -s days:index && next dev",
    "build": "npm run -s days:index && next build",
    "start": "next start",
    "lint": "eslint",
    "days:index": "node scripts/generate-day-index.mjs",
    "phases:suggest": "node scripts/suggest-phases.mjs",
    "preview": "npm run -s days:index && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run -s days:index && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.118.0"
  }
}
